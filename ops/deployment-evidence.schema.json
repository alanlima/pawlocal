{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawlocal.example/schemas/deployment-evidence.schema.json",
  "title": "PawLocal deployment verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "commit",
    "backend_image_digest",
    "frontend_artifact_digest",
    "database_provider",
    "migration_runner",
    "migration_id",
    "telemetry_enabled",
    "public_endpoint_health",
    "database_query_smoke",
    "verified_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "enum": ["development", "production"] },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "backend_image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "frontend_artifact_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "database_provider": { "enum": ["postgresql", "aurora_dsql"] },
    "migration_runner": { "enum": ["alembic", "dsql_baseline"] },
    "migration_id": { "type": "string", "minLength": 1 },
    "telemetry_enabled": { "const": false },
    "public_endpoint_health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontend", "api"],
      "properties": {
        "frontend": { "const": true },
        "api": { "const": true }
      }
    },
    "database_query_smoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "result"],
      "properties": {
        "route": { "const": "/api/v1/places" },
        "result": { "const": "valid_place_page" }
      }
    },
    "verified_at": { "type": "string", "format": "date-time" }
  }
}
