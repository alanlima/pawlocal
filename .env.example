# Local-only Docker Compose controls. Compose defaults telemetry to enabled.
PAWLOCAL_TELEMETRY_ENABLED=true
PAWLOCAL_DEMO_FAULTS=true
PAWLOCAL_DEMO_FAULTS_ENABLED=true

# The UI uses MockPlaceService only when this is explicitly true.
# Unset or false selects HttpPlaceService through the same-origin /api/v1 path.
VITE_USE_MOCK_BACKEND=true
VITE_API_BASE_URL=/api/v1
# Vite development proxy target; Compose can set this to http://backend:8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Keep real credentials out of this file and out of version control.

