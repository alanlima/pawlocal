{
  "id": null,
  "uid": "pawlocal-${environment}-incidents",
  "title": "PawLocal ${title(environment)} - Incidents",
  "schemaVersion": 39,
  "version": 0,
  "tags": [
    "pawlocal-managed-226"
  ],
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Source-controlled #226. Missing data is unknown, never zero/healthy. Release is the deployed sha256 image digest. Authorization is enforced by datasource/token scopes, not dashboard variables.",
  "folderUid": "pawlocal-${environment}",
  "links": [
    {
      "title": "Incident triage",
      "type": "link",
      "url": "/d/pawlocal-${environment}-incidents",
      "includeVars": true
    },
    {
      "title": "Metrics / logs / traces Explore",
      "type": "link",
      "url": "/explore",
      "includeVars": false
    },
    {
      "title": "Account quota and usage",
      "type": "link",
      "url": "/a/grafana-billing-usage-app/usage"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "${environment}",
        "current": {
          "text": "${environment}",
          "value": "${environment}"
        },
        "hide": 2
      },
      {
        "name": "service",
        "type": "constant",
        "query": "pawlocal-api",
        "current": {
          "text": "pawlocal-api",
          "value": "pawlocal-api"
        }
      },
      {
        "name": "release",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics_uid}"
        },
        "query": "label_values(pawlocal_api_requests_total{environment=\"${environment}\",service=\"pawlocal-api\"}, release)",
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "traceId",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {"text": "", "value": ""}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "title": "External journey success",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"pawlocal-${environment}-search-detail\"}",
          "legendFormat": "{{route}}{{dependency}}{{signal}}{{release}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "NO DATA / UNKNOWN"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Failing routes",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(pawlocal_api_requests_total{environment=\"${environment}\",service=~\"$service\",release=~\"$release\",outcome=\"error\"}[5m]))",
          "legendFormat": "{{route}}{{dependency}}{{signal}}{{release}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "NO DATA / UNKNOWN"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Redacted logs and trace IDs",
      "type": "logs",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${logs_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\"$service\"} | json | environment=\"${environment}\" | release=~\"$release\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA / UNKNOWN"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Related traces",
      "type": "table",
      "description": "Sampled traces for the selected environment and release. Open a result in Explore or copy its trace ID into Trace ID for the waterfall below. Request logs with trace_sampled=false intentionally have no stored trace; older logs omit this field.",
      "datasource": {
        "type": "tempo",
        "uid": "${traces_uid}"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service\" && resource.deployment.environment.name = \"${environment}\" && resource.service.version =~ \"$release\" }"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA / UNKNOWN"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Selected trace waterfall",
      "type": "traces",
      "description": "Enter a sampled trace ID in the Trace ID box above. Inspect browser, API, application and database spans when those components exported the same trace.",
      "datasource": {"type": "tempo", "uid": "${traces_uid}"},
      "targets": [{"refId": "A", "queryType": "traceql", "query": "$traceId"}],
      "fieldConfig": {"defaults": {"unit": "short", "noValue": "NO DATA / UNKNOWN"}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "id": 5,
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 9}
    }
  ]
}
