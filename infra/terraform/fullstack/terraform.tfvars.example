aws_region                 = "ap-southeast-2"
root_domain                = "example.org"
cloudfront_certificate_arn = "arn:aws:acm:us-east-1:000000000000:certificate/replace-me"
github_repository          = "owner/repository"
github_owner_id            = "0000000"
github_repository_id       = "00000000"
manage_github_oidc_provider = false
ssh_cidr_blocks             = ["203.0.113.0/24"]
deploy_ssh_public_keys = {
  development = "ssh-ed25519 REPLACE_WITH_DEV_PUBLIC_KEY"
  production  = "ssh-ed25519 REPLACE_WITH_PROD_PUBLIC_KEY"
}
enable_dsql_auth_event_capture = true
# dsql_auth_alert_email = "operator@example.org"
