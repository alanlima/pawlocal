# Copy to terraform.tfvars and fill in values for the target AWS account.
# terraform.tfvars is ignored by Git.
domain_name          = "example.com"
certificate_arn      = "arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"
github_repository    = "owner/repository"
