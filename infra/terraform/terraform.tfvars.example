# Copy to terraform.tfvars and fill in values for the target AWS account.
# terraform.tfvars is ignored by Git.
domain_name          = "example.com"
certificate_arn      = "arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"
github_repository    = "owner/repository"
github_owner_id      = "123456"
github_repository_id = "1234567890"
environment          = "production"

# The existing root state already manages the account-level GitHub Actions OIDC provider.
# Keep true so Terraform retains ownership at the existing root state address.
manage_github_oidc_provider = true

# Required inputs for the Lightsail API deployment path. Use restricted, owner-approved
# administrator ranges; the runner EIP /32 is added when the CodeBuild runner is enabled.
# Private keys belong in GitHub environment secrets.
ssh_admin_cidr_blocks = ["REPLACE_WITH_OWNER_APPROVED_ADMIN_CIDR"]
enable_codebuild_runner = false
dsql_bootstrap_python = "C:/path/to/pawlocal/backend/.venv/Scripts/python.exe"
deploy_ssh_public_keys = {
  development = "REPLACE_WITH_DEV_SSH_PUBLIC_KEY"
  production  = "REPLACE_WITH_PROD_SSH_PUBLIC_KEY"
}

# DSQL audit capture is disabled until the owner selects a destination and retention.
enable_dsql_auth_event_capture = false
# dsql_auth_audit_bucket_name = "owner-selected-globally-unique-bucket"
# dsql_auth_retention_days    = <owner-selected-positive-whole-number>
# dsql_auth_alert_email       = "operator@example.org"
